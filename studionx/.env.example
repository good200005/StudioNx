# studionx/.env 로 복사해서 사용 (.env 는 git에 올리지 않음)
APP_ENV=dev

# MySQL — db/00_create_database.sql 로 만든 계정
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=studionx
DB_USER=studionx_app
DB_PASSWORD=

# 인증 — 아무 긴 랜덤 문자열 (예: python -c "import secrets;print(secrets.token_hex(32))")
JWT_SECRET=change-me

# Sentry — 비워 두면 비활성화
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
# 화면(브라우저)의 JS 오류용 — 서버용과 다른 Sentry 프로젝트(Browser JavaScript)의 DSN. 공개 값이며 비워 두면 화면은 보내지 않음
SENTRY_BROWSER_DSN=

# 프록시(Nginx 등) 뒤에서 돌 때만 true — X-Forwarded-For 로 보낸 사람 IP 를 읽음 (문의 반복 전송 제한)
TRUST_PROXY=false

# 관리자 화면(/admin) 주소 — 개발은 그대로 두고, 배포 때 추측하기 어려운 값으로 바꿈 (예: /ops-7f3a9c1e)
ADMIN_PATH=/admin

# 메일 (P1-28 비밀번호 찾기) — log: 보내지 않고 서버 로그에 링크 출력 (개발 전용, 배포 금지)
MAIL_BACKEND=log
APP_BASE_URL=http://localhost:8000

# 샘플 업로드 (S1-07) — 파일 하나 최대 크기(바이트). 기본 100MB (FR-222)
SAMPLE_MAX_BYTES=104857600
