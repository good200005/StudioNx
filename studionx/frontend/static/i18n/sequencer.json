 "templates": {
  "_about": "JS 가 값을 넣어 만드는 문장 ({이름} 자리에 값). 위 skip 에 들어 있는 .sq-dialog__body p · .sq-option small 등",
  "overlap.message": {
   "en": "<b>{pattern}</b> (bars {from}–{to}) was placed inside <b>{automation}</b>, which is applied to <b>{target}</b> (bars {aFrom}–{aTo}).",
   "ko": "<b>{pattern}</b>({from}–{to}마디)을 <b>{target}</b>({aFrom}–{aTo}마디)에 걸린 <b>{automation}</b> 안에 놓았어요.",
   "ja": "<b>{pattern}</b>({from}–{to} 小節)を、<b>{target}</b>({aFrom}–{aTo} 小節)にかかる <b>{automation}</b> の中に置きました。"
  },
  "overlap.trim": {
   "en": "Keep the curve up to bar {bar} on {target}. The rest is removed.",
   "ko": "{target}에는 {bar}마디까지의 곡선만 남기고 나머지는 지워요.",
   "ja": "{target} には {bar} 小節までのカーブを残し、残りは削除します。"
  },
  "overlap.split": {
   "en": "Cut into two clips — the second part ({bar}–{end}) now applies to {pattern}.",
   "ko": "두 클립으로 나눠요 — 뒷부분({bar}–{end})은 {pattern}에 걸려요.",
   "ja": "2 つのクリップに分割 — 後半({bar}–{end})は {pattern} にかかります。"
  },
  "overlap.undo": {
   "en": "Put {pattern} back. The automation stays as it was.",
   "ko": "{pattern}을 원래 자리로 되돌려요. 오토메이션은 그대로예요.",
   "ja": "{pattern} を元に戻します。オートメーションはそのままです。"
  },
  "track.askAudio": {
